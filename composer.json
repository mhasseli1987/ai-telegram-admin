{
    "name": "rtl-theme/ai-telegram-admin",
    "description": "AI Telegram Admin Plugin for WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-2.0+",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "autoload": {
        "psr-4": {
            "ATA\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ATA\\Tests\\": "includes/Tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:integration": "phpunit --configuration phpunit.xml includes/Tests/Integration/",
        "test:unit": "phpunit --configuration phpunit.xml includes/Tests/*.php",
        "cs": "phpcs",
        "cs:fix": "phpcbf"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}